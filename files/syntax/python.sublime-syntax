%YAML 1.2
---
name: python
file_extensions: [py, pyi, pyd, pyw]
scope: source.python

contexts:
  main:
    # 1. Structural Symbols
    - match: '\{|\}|\(|\)|\[|\]'
      scope: syntax.separator

    - match: ':|;|\.'
      scope: syntax.separator.delimiter

    - match: ','
      scope: syntax.separator.comma

    - match: '\b(if|else|elif|for|while|break|continue|return|yield|try|except|finally|raise|assert|pass|with|as)\b'
      scope: keyword.control

    - match: '\b(def|class|lambda|global|nonlocal|import|from|del|in|is|and|or|not|async|await)\b'
      scope: keyword.other

    - match: '\b(True|False|None)\b'
      scope: constant.language

    - match: '\b(int|float|str|bool|list|dict|set|tuple|object|type|print|len|range|enumerate|zip|int|float)\b'
      scope: entity.type

    - match: '\b(def|class)\s+([a-zA-Z_]\w*)'
      captures:
        1: keyword.other
        2: entity.name.function

    - match: '\b([a-zA-Z_]\w*)(?=\s*\()'
      scope: entity.function

    - match: '#.*$'
      scope: comment

    - match: \b[0-9]+\.[0-9]+\b
      scope: literal.float

    - match: \b[0-9]+\b
      scope: literal.integer

    - match: "'"
      push: char

    - match: '"'
      push: string

  string:
    - meta_scope: literal.string
    - match: '\\.'
      scope: constant.character.escape
    - match: '"'
      pop: true

  char:
    - meta_scope: literal.char
    - match: '\\.'
      scope: constant.character.escape
    - match: "'"
      pop: true
